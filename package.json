{
  "name": "iot-controller-nodejs",
  "version": "1.0.0",
  "description": "阿里云 IoT 本地控制端",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "dev:watch": "nodemon --exec ts-node src/server.ts",
    "test": "ts-node tests/test-all.ts",
    "test:query": "ts-node tests/test-query.ts",
    "test:property": "ts-node tests/test-property.ts",
    "test:service": "ts-node tests/test-service.ts",
    "test:connection": "ts-node tests/test-connection.ts",
    "example:client": "ts-node examples/ide-client-example.ts",
    "example:deploy": "ts-node examples/deploy-example.ts",
    "example:start": "ts-node examples/start-example.ts",
    "clean": "rimraf dist"
  },
  "keywords": [
    "iot",
    "aliyun",
    "mqtt"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@alicloud/iot20180120": "^3.0.8",
    "@alicloud/openapi-client": "^0.4.0",
    "@types/archiver": "^7.0.0",
    "ali-oss": "^6.23.0",
    "archiver": "^7.0.1",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.3",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
